# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real credentials.

# ---------------------------------------------------------------------------
# Public variables
# Exposed to the browser. Must be prefixed with NEXT_PUBLIC_.
# Validated in src/lib/env/client.ts. Never place secrets here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=HanGo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Private variables
# Server-only. Never prefix these with NEXT_PUBLIC_.
# Validated in src/lib/env/server.ts.
# AI/audio provider credentials (FASE 8/9) will add entries here as those
# phases are implemented.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hango?schema=public"

# Auth.js session encryption key. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="generate-a-real-secret-do-not-use-this-value"

# Google Sign-In (FASE 2.5) — optional. Leave unset to keep the app working
# with email/password only; the Google button will show a friendly
# "not configured" error instead of failing silently.
#
# To get real values:
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Client ID ("Web application")
#   3. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#      (replace the origin with your real domain in production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional email for account verification and password recovery.
# Create an API key and verify your sending domain in Resend. In production,
# both values are required; secret links are never printed to application logs.
RESEND_API_KEY=""
EMAIL_FROM="HanGo <accounts@example.com>"

# Authenticates Vercel/external cron calls (leaderboard payout and private
# Speaking-audio retention). Generate a separate high-entropy production value.
CRON_SECRET=""

# AI Teacher (FASE 8) — optional. Leave both unset to run against a mock
# provider (canned but context-aware responses, no network calls, no
# cost) so the app works without an API key. Set OPENAI_API_KEY to switch
# to real responses with no code changes — OpenAI is this project's chosen
# provider (see TASKS.md FASE 8.1). ANTHROPIC_API_KEY also works and is
# used only if OPENAI_API_KEY is unset (the provider abstraction supports
# either).
#
# To get a real OpenAI value:
#   1. https://platform.openai.com/api-keys -> Create new secret key
#   2. Requires a funded account (pay-as-you-go, not free)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
