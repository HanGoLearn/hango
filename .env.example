# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real credentials.

# ---------------------------------------------------------------------------
# Public variables
# Exposed to the browser. Must be prefixed with NEXT_PUBLIC_.
# Validated in src/lib/env/client.ts. Never place secrets here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=HanGo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Private variables
# Server-only. Never prefix these with NEXT_PUBLIC_.
# Validated in src/lib/env/server.ts.
# AI/audio provider credentials (FASE 8/9) will add entries here as those
# phases are implemented.
# ---------------------------------------------------------------------------
# Runtime connection. Keep the local URL below for development. In Vercel,
# paste the POOLED Prisma Postgres URL exactly as provided by the console.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hango?schema=public"

# Migration/admin connection. In production this must be the DIRECT Prisma
# Postgres URL (TLS enabled), never the pooled runtime URL. Prisma CLI falls
# back to DATABASE_URL locally when DIRECT_URL is empty/unset.
DIRECT_URL=""

# Maximum connections opened by each running app instance. Five is the safe
# serverless beta default; local development keeps 20 when this is empty.
DATABASE_POOL_MAX=""

# Environment-specific Journey evaluation rollout, after its evidence migrations.
# Use "local" only with next dev, "production" only in a migrated production
# environment, or "off" to keep the existing flow. Tests never opt in.
HANGO_JOURNEY_EVALUATION_V2=off

# Auth.js session encryption key. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="generate-a-real-secret-do-not-use-this-value"

# Google Sign-In (FASE 2.5) — optional. Leave unset to keep the app working
# with email/password only; the Google button will show a friendly
# "not configured" error instead of failing silently.
#
# To get real values:
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Client ID ("Web application")
#   3. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#      (replace the origin with your real domain in production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional email for account verification and password recovery.
# Create an API key and verify your sending domain in Resend. In production,
# both values are required; secret links are never printed to application logs.
RESEND_API_KEY=""
EMAIL_FROM="HanGo <accounts@example.com>"

# Authenticates Vercel/external cron calls (leaderboard payout and private
# Speaking-audio retention). Generate a separate high-entropy production value.
CRON_SECRET=""

# First closed-beta learning scope. FOUNDATIONS_ONLY keeps the public learner
# experience focused on Foundations and three guided Speaking Lab stations;
# administrators still retain complete QA access. Set FULL to restore the
# complete published curriculum and the existing full Speaking Lab.
HANGO_BETA_LEARNING_SCOPE="FOUNDATIONS_ONLY"

# Closed-beta registration. INVITE_ONLY requires an administrator-created
# invitation for every new email/password or Google account. Existing accounts
# can still sign in. Set OPEN later to restore public account creation.
HANGO_BETA_ACCESS_MODE="INVITE_ONLY"

# Private object storage. Keep local for development/tests. In production use
# vercel-blob and connect a PRIVATE Vercel Blob store to the project; Vercel
# supplies BLOB_STORE_ID and a short-lived VERCEL_OIDC_TOKEN automatically.
# BLOB_READ_WRITE_TOKEN is only a legacy/non-Vercel fallback. Never expose any
# of these values as NEXT_PUBLIC_*.
HANGO_STORAGE_PROVIDER="local"
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# AI Teacher (FASE 8) — optional. Leave both unset to run against a mock
# provider (canned but context-aware responses, no network calls, no
# cost) so the app works without an API key. Set OPENAI_API_KEY to switch
# to real responses with no code changes — OpenAI is this project's chosen
# provider (see TASKS.md FASE 8.1). ANTHROPIC_API_KEY also works and is
# used only if OPENAI_API_KEY is unset (the provider abstraction supports
# either).
#
# To get a real OpenAI value:
#   1. https://platform.openai.com/api-keys -> Create new secret key
#   2. Requires a funded account (pay-as-you-go, not free)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
